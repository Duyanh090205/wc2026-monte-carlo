# clubelo_cache.json, eloratings_top20_*, tournament_meta.json, ucl_*) ARE tracked.
data/mc_simu/phase3_baselines/
data/mc_simu/mc_wc2026_*.csv
data/mc_simu/loto_cv_*.csv
data/mc_simu/replay_*

# Internal audit + preliminary report docs — kept local, not pushed.
# (Moved under mc_simu/audits/ — scope*.md and before_world_cup_audit.md in that
#  folder are NOT ignored and remain trackable.)
mc_simu/audits/audit_overrides.md
mc_simu/audits/audit_report.md
mc_simu/audits/phase0_audit_report.md
mc_simu/audits/preliminary_report.md
mc_simu/preliminary_report.pptx
