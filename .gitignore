# Secrets
.env

# Data files — large/regenerable sources stay out
data/raw/predexon/**/*.csv
data/raw/predexon/**/*.json
# But keep index files and directory markers
!data/raw/predexon/market_index.json
!data/raw/predexon/kalshi_market_index.json
!data/**/.gitkeep

# Scraper/probe debug HTML
data/*.html

# Sportsbook snapshot data — small, keep in git
# data/raw/oddschecker/**          -> tracked
# data/raw/sgo/**                  -> tracked
# data/raw/pinnacle/**             -> tracked
# data/raw/betfair/**              -> tracked
# data/raw/polymarket_orderbook/** -> tracked (bid-ask snapshots)
# data/raw/kalshi_orderbook/**     -> tracked (bid-ask snapshots)

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
