# Secrets
.env

# Data files — large/regenerable sources stay out
data/predexon/**/*.csv
data/predexon/**/*.json
# But keep index files and directory markers
!data/predexon/market_index.json
!data/predexon/kalshi_market_index.json
!data/**/.gitkeep

# Scraper/probe debug HTML
data/*.html

