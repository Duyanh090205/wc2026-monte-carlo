# Secrets
.env

# ── Predexon (large OHLCV data — not tracked) ─────────────────────────────────
data/predexon/**/*.csv
data/predexon/**/*.json
# Keep index files
!data/predexon/market_index.json
!data/predexon/kalshi_market_index.json
!data/**/.gitkeep

# ── Sportsbook timestamped snapshots (keep latest.json only) ──────────────────
# Scrapers create a new timestamped CSV each run — these bloat git history.
# Only the latest.json snapshot is tracked for each source.

data/oddschecker/**/*.csv
data/sportsgameodds/**/*.csv
data/pinnacle/**/*.csv
data/the_odds_api/**/*.csv
data/orderbooks/**/*.csv
data/normalized/**/*.csv

# Keep latest.json for each source
!data/oddschecker/**/latest.json
!data/sportsgameodds/**/latest.json
!data/pinnacle/**/latest.json
!data/the_odds_api/**/latest.json
!data/orderbooks/**/latest.json
!data/normalized/entity_map.json

# ── Football-data.co.uk (historical, large — not tracked) ─────────────────────
data/football_data_uk/

# ── Scraper debug HTML ─────────────────────────────────────────────────────────
data/*.html
data/**/*.html

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Stray artifact files ──────────────────────────────────────────────────────
compass_artifact_*.md
